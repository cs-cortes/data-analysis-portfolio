   ],
   "source": [
    "import sys\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "print(\"Python:\", sys.version)\n",
    "print(\"Pandas:\", pd.__version__)\n",
    "print(\"NumPy:\", np.__version__)\n",
    "print(\"Entorno:\", sys.executable)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "198f1ccd",
   "metadata": {},
   "source": [
    "### 2.2 Loading CSV Files"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "497dec73",
   "metadata": {},
   "outputs": [],
   "source": [
    "customers = pd.read_csv(\"../data/raw/customers.csv\")\n",
    "orders = pd.read_csv(\"../data/raw/orders.csv\")\n",
    "order_items = pd.read_csv(\"../data/raw/order_items.csv\")\n",
    "products = pd.read_csv(\"../data/raw/products.csv\")\n",
    "suppliers = pd.read_csv(\"../data/raw/suppliers.csv\")\n",
    "payments = pd.read_csv(\"../data/raw/payment.csv\")\n",
    "reviews = pd.read_csv(\"../data/raw/reviews.csv\")\n",
    "shipments = pd.read_csv(\"../data/raw/shipments.csv\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "68827dd6",
   "metadata": {},
   "source": [
    "### 2.3 DataFrame Dictionary"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "094e1c1a",
   "metadata": {},
   "outputs": [],
   "source": [
    "tables = {\n",
    "    \"customers\": customers,\n",
    "    \"orders\": orders,\n",
    "    \"order_items\": order_items,\n",
    "    \"products\": products,\n",
    "    \"suppliers\": suppliers,\n",
    "    \"payments\": payments,\n",
    "    \"reviews\": reviews,\n",
    "    \"shipments\": shipments\n",
    "}"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "bb60b319",
   "metadata": {},
   "source": [
    "## 3. Table Profiling\n",
    "\n",
    "### 3.1 Objective\n",
    "\n",
    "Analyze the overall structure of the dataset, considering the number of records (rows), attributes (columns), null values, duplicate records, and memory usage.\n",
    "\n",
    "### 3.2 Code"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "4779bc99",
   "metadata": {},
   "outputs": [],
   "source": [
    "profiling = []\n",
    "\n",
    "for name, df in tables.items():\n",
    "    profiling.append({\n",
    "        \"table\": name,\n",
    "        \"rows\": df.shape[0],\n",
    "        \"columns\": df.shape[1],\n",
    "        \"null_values\": df.isna().sum().sum(), # sum por columna y suma total\n",
    "        \"duplicate_rows\": df.duplicated().sum(), # filas completas idénticas\n",
    "        \"memory_mb\": round(df.memory_usage(deep = True).sum() / (1024 ** 2), 2)\n",
    "    })\n",
    "\n",
    "profiling_df = pd.DataFrame(profiling)\n"
   ]
  },
